<!doctype html>
<html>
<head>
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>${title!} - Test Report</title>
${css?no_esc}</head>
<body style="font-family:Helvetica, sans-serif;-webkit-font-smoothing:antialiased;font-size:14px;line-height:1.4;-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%;background-color:#f6f6f6;margin:0;padding:0;width:100%;overflow-x:hidden;">
<table border="0" cellpadding="0" cellspacing="0" class="body" style="border-collapse:separate;mso-table-lspace:0pt;mso-table-rspace:0pt;width:100%;">
    <tr>
        <td style="font-family:Helvetica, sans-serif;font-size:14px;vertical-align:top;">&nbsp;</td>
        <td class="container" style="font-family:Helvetica, sans-serif;font-size:14px;vertical-align:top;margin:0 auto !important;max-width:600px;padding:0;padding-top:24px;width:90%;">
            <div class="content" style="box-sizing:border-box;display:block;margin:0 auto;max-width:100%;padding:0;">
                <table border="0" cellpadding="0" cellspacing="0" class="main" style="border-collapse:separate;mso-table-lspace:0pt;mso-table-rspace:0pt;background:#fff;border-radius:4px;width:100%;">
${alertBar?no_esc}${summarySection?no_esc}${viewFullReportButton?no_esc}${coverageSection?no_esc}${failureOverview?no_esc}${failureAndResultList?no_esc}${monitorFailureSection?no_esc}                    <tr class="footer" style="clear:both;padding-top:24px;text-align:center;width:100%;">
                        <td style="font-family:Helvetica, sans-serif;vertical-align:top;color:#999999;font-size:12px;text-align:center;">
                            Report produced by Serenity BDD
                        </td>
                    </tr>
                </table>
            </div>
        </td>
        <td style="font-family:Helvetica, sans-serif;font-size:14px;vertical-align:top;">&nbsp;</td>
    </tr>
</table>
</body>
</html>