<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>pw_automation_framework</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pw-codegen</artifactId>
    <name>Automation Framework - Codegen V3</name>

    <properties>
        <!-- codegen 模块内大量 best-effort UI/通信空 catch，暂不纳入 checkstyle 门禁（同 v2）。 -->
        <checkstyle.skip>true</checkstyle.skip>
    </properties>

    <description>V3 code-generator / Inspector：Chrome --app= 独立窗口面板 + CDP 拾取 + 移植 Playwright
        roleUtils/selectorGenerator 算法。纯 Java/Maven，不引入 Electron/Node.js（与 Playwright Inspector
        自身的实现方式一致）。彻底摒弃 v2 的 setContent 注入面板 + evaluate 通信方案。</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-web-ui</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- 模板统一：与框架报告侧（pw-reports）共用 FreeMarker 引擎生成产物 -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- P4 第三刀：R1-R9 分层测试 + 结构护栏。ArchUnit 仅检查结构约束
             （治理闭包零运行时浏览器 / 零 LLM、治理逻辑纯内存、审批入口无旁路）。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit4</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- SpotBugs 抑制注解：仅编译期用于标注经评审确认属有意单例等模式，不进入运行期 classpath -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.9.8</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              候选库 CLI 的运行入口（P3 操作闭环）。
              用法：mvn -q -pl pw-codegen exec:java -Dexec.args="help"
              注意 exec:java 的工作目录是模块目录（pw-codegen/），相对路径按模块根解析。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.hsbc.cmb.hk.dbb.automation.framework.web.page.codegen.locator.candidate.CandidateCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
