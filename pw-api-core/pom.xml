<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>pw-framework-bom</artifactId>
        <version>1.0.1</version>
        <relativePath>../pw-framework-bom/pom.xml</relativePath>
    </parent>

    <artifactId>pw-api-core</artifactId>
    <name>pw-api-core (API testing)</name>
    <description>API testing layer: framework.api (RestAssured). Depends on pw-core, reporting.</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Declare external libraries used directly by this module instead of relying on transitive dependencies. -->
        <!-- M3：纯 RestAssured（代码已用 io.restassured.*，非 SerenityRest；去 serenity-model/core/rest-assured 与 legacy pw-reports）。 -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <!-- Validate JSON responses with JSON Schema; exclude YAML support to avoid a Jackson version mismatch. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>jackson-dataformat-yaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
        </dependency>
        <!-- RestAssured needs commons-logging at runtime; declare it explicitly rather than relying on Serenity. -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <!-- API code uses Selenium support types; declare the dependency explicitly to avoid compile-time linkage failures. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>

        <!-- JUnit 4 test dependency, consistent with the framework test runner. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mockito tests the executeWithRetry retry core without loading SerenityRest in plain JUnit tests. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!--
          PAR-7 JaCoCo line coverage gate.
          The floor started at 0.23 and was raised to 0.40 after coverage improved to 43.1%
          (792 of 1836 lines) in the 2026-09-20 measurement. The gate only allows the threshold
          to increase; verify fails if coverage drops below the configured floor.
        -->
        <api.line.coverage.floor>0.40</api.line.coverage.floor>
    </properties>

    <build>
        <plugins>
            <!-- PAR-7: API module coverage report and gate; the parent POM prepares JaCoCo for all modules. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- Generate this module's XML coverage report during the test phase. -->
                    <execution>
                        <id>api-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                    <!-- Fail verify when bundle line coverage falls below the floor; the floor may only increase. -->
                    <execution>
                        <id>api-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${api.line.coverage.floor}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
