<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>pw-framework-bom</artifactId>
        <version>1.0.1</version>
        <relativePath>../pw-framework-bom/pom.xml</relativePath>
    </parent>

    <artifactId>pw-api-core</artifactId>
    <name>pw-api-core (API testing)</name>
    <description>API testing layer: framework.api (RestAssured). Depends on pw-core, reporting.</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ENG-P0-2锛歛pi 瀹為檯鐢ㄥ埌鐨勫閮ㄤ緷璧栵紙鍘熺敱鏍?<dependencies> 缁ф壙锛岀幇鏄惧紡澹版槑锛?-->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <!-- P-7锛氬搷搴斿绾︽牎楠岋紙JSON Schema锛夈€備粎鐢?JSON 鏍￠獙锛屾晠鎺掗櫎 YAML schema 浼犻€掍緷璧?
             jackson-dataformat-yaml锛岄伩鍏嶅叾 2.17.1 涓庨」鐩拤瀹氱殑 jackson-core/databind 2.18.3 鐗堟湰鍋忔枩銆?-->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>jackson-dataformat-yaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
        </dependency>
        <!-- RestAssured POST 杩愯鏈熼渶瑕?commons-logging(LogFactory)锛泂erenity-* 宸插皢鍏舵帓闄わ紝姝ゅ鏄惧紡琛ュ洖 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <!-- selenium-support锛歴erenity 鍏紑 API 寮曠敤 org.openqa.selenium.support.ui.*锛堝 ExpectedCondition锛夈€?
             淇濈暀鏄惧紡澹版槑锛氫笌 web 鍚岀瓥鐣ワ紝闃?ENG-P0-2 涓嬫矇鍚?javac 绗﹀彿琛ュ叏 CompletionFailure銆?-->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>

        <!-- 璇勫08绫?6 / A-4锛歛pi 妯″潡棣栦釜鍗曟祴鍩哄骇锛圝Unit 4锛屽叏妗嗘灦缁熶竴锛?-->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 璇勫08绫?6 / A-4锛歛pi 妯″潡鍗曟祴鍩哄骇锛圡ockito 椹卞姩 executeWithRetry 閲嶈瘯鍐呮牳锛?
             缁曞紑 SerenityRest 鍦ㄧ函 JUnit 涓嬬殑 classloader 绾︽潫锛?-->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!--
          PAR-7 JaCoCo 琛岃鐩栫巼涓嬮檺锛?026-09-17 棣栨钀藉湴锛?026-09-20 涓婅皟鑷崇洰鏍囦綅锛夈€?
          鍙ｅ緞锛歞oc05 搂5.2 寤鸿銆屽厛璁句綆闂ㄦ骞跺彧鍏佽涓婂崌銆嶃€?
          棣栫増瀹炴祴 = 23.5%锛?27/1818锛夛紝涓嬮檺鍙?0.23 浠ュ惎鍔ㄣ€屽彧鍗囦笉闄嶃€嶉棬绂併€?
          2026-09-20 琛ユ祴锛氭柊澧?HttpStatusTest / JsonUtilsTest / ApiLogSanitizerTest / FileReaderTest /
          EnvironmentUtilsTest / ConfigProviderTest锛?2 娴嬭瘯璧勬潗锛夛紝瀹炴祴 LINE 瑕嗙洊鐜?= 43.1%锛?92/1836锛夛紝
          鏁呬笅闄愪笂璋冭嚦 **0.40**锛坉oc 涓棦瀹氱洰鏍囦綅锛夛紝浠嶄繚鐣欑害 3pp 浣欓噺浠ラ槻鐜宸紓銆?
          鑻ユ煇娆℃彁浜ゅ皢 api 琛岃鐩栫巼鎷夊埌 0.40 浠ヤ笅锛寁erify 鍗冲け璐ワ紙鎻愮ず鍒犳祴璇?/ 閫€鍖栵級銆?
        -->
        <api.line.coverage.floor>0.40</api.line.coverage.floor>
    </properties>

    <build>
        <plugins>
            <!-- PAR-7锛歛pi 妯″潡鑷韩瑕嗙洊鐜囨姤鍛?+ 闂ㄧ锛坧repare-agent 鐢辩埗 POM 涓烘墍鏈夋ā鍧楁敞鍏ワ級 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- 鍦?test 闃舵浜у嚭 api 妯″潡鑷韩鐨?XML 鎶ュ憡锛堟鍓嶄粎鍦?test-automation 鍑烘姤鍛婏級 -->
                    <execution>
                        <id>api-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                    <!-- 闂ㄧ锛欱UNDLE 琛岃鐩栫巼涓嶅緱浣庝簬涓嬮檺锛屽惁鍒?verify 澶辫触锛堜粎鍗囦笉闄嶏級 -->
                    <execution>
                        <id>api-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${api.line.coverage.floor}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

