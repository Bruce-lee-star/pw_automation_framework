<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>pw_automation_framework</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pw-route</artifactId>
    <name>Automation Framework - Route (Concurrency-Safe)</name>
    <description>
        Route module with concurrency-safe request routing and per-context runtime isolation.
        Routing decisions stay non-blocking on Playwright callback threads; blocking work runs
        on bounded I/O workers. Rule snapshots are published atomically, and failures fall back
        to the next handler so requests do not hang. The module depends on Playwright, SLF4J,
        and pw-core SPI contracts, but not on sibling route or web implementation modules.
    </description>

    <dependencies>
        <!-- Core SPI contracts for route lifecycle integration; no route/web implementation dependency. -->
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- JSONPath assertions used by MONITOR expectJsonPath; version comes from dependencyManagement. -->
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <!-- Gson is used to read monitor failure reports across process boundaries. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- JUnit 4 and Mockito are test-only dependencies; JUnit is explicitly versioned here. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit core enforces architecture boundaries in tests; JUnit 4 is used directly by the tests. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
