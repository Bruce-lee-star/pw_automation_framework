<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      D2-4：接管 msg 转换词 —— 所有 %msg / %m 输出前统一经 SensitiveDataSanitizer 脱敏，
      调用方无法绕过（出口强制，而非调用方自觉）。conversionRule 必须声明在 appender 之前。
    -->
    <conversionRule conversionWord="msg"
                    class="com.hsbc.cmb.hk.dbb.automation.framework.common.logging.SanitizingMessageConverter"/>

    <!--
      C-2 / L-1：接管 ex 转换词 —— 异常栈（%ex）在写出前统一经 SensitiveDataSanitizer 脱敏，
      覆盖异常 message 内嵌的 password=... / token=... 等凭据；脱敏失败输出 [LOG SUPPRESSED] 而非原文。
      conversionRule 必须声明在 appender 之前。
    -->
    <conversionRule conversionWord="ex"
                    class="com.hsbc.cmb.hk.dbb.automation.framework.common.logging.SanitizingThrowableConverter"/>

    <!--
      D3-1：诊断上下文（MDC）由 framework.common.logging.LogContext 写入，
      可在 pattern 中通过 %X{scenarioId} / %X{threadId} 引用；
      `:-` 为 logback 的默认值语法，未绑定时输出 "-"，避免出现难看的 "null"。
      （原 %X{env} 已移除：本框架无全局「环境」标量来源——真实环境是场景级登录维度，
      该列恒为 unknown，属误导性死列。）
    -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} [%thread] [%X{scenarioId}] %-5level %logger{36} - %msg%n"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{threadId}] [%X{scenarioId}] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台输出配置 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      滚动文件输出（D3-1）：日志按 scenario / 线程落盘，
      并行执行后可回放单条链路；按天 + 按大小滚动，压缩归档并限制总量，防止磁盘被日志撑爆。
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/framework.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/framework.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 第三方库日志级别配置 - 抑制噪声 -->
    <logger name="io.cucumber" level="WARN"/>
    <logger name="io.github.bonigarcia" level="WARN"/>

    <!--
      Codegen 输出日志死开关（v2.16）：默认 WARN —— 关掉刷屏级 INFO/DEBUG
      （regen 汇总、拾取/解析/面板推送、RoleElementPicker 细节等），
      保留 WARN/ERROR 异常（失败必须可见，不做黑盒）。
      需要详细日志时重启并显式打开（二选一）：
        -Dpw.codegen.log=INFO   拾取/生成/面板常规过程
        -Dpw.codegen.log=DEBUG  含 CDP/选择器反查等细节
      完全静默（异常也不输出，不建议）：-Dpw.codegen.log=OFF
      属性在 JVM 启动时由 logback 读取，改动后需重启生效；
      覆盖范围：v3 录制引擎（...web.page.codegen）与 v2 scan 引擎（...web.page.scan）。
    -->
    <logger name="com.hsbc.cmb.hk.dbb.automation.framework.web.page.codegen"
            level="${pw.codegen.log:-WARN}"/>
    <logger name="com.hsbc.cmb.hk.dbb.automation.framework.web.page.scan"
            level="${pw.codegen.log:-WARN}"/>

    <!-- root 日志级别由 logging.root.level 设置（支持 TRACE / DEBUG / INFO / WARN / ERROR / OFF）。 -->
    <root level="${logging.root.level:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
