<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>pw_automation_framework</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pw-web-ui</artifactId>
    <name>pw-web-ui (Web/UI automation)</name>
    <description>Web/UI layer: framework.web (Playwright). Depends on pw-core, reporting, api. Excludes route.</description>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 报告引擎（v2，零 serenity 依赖）：提供 ReportingBridge SPI 实现，经 ReportingBridgeRegistry 自动发现。
             替代原 pw-reports（Serenity 适配器）。 -->
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 闭环引擎端到端测试（test 作用域）：跨层验证「分析层 StepPlanProducer 产出
             → 真实浏览器 StepPlanRunner 验证」。仅 test 作用域，生产代码不反向依赖分析层，
             不违反「分析层零浏览器、不得依赖 web-ui」的架构铁律。 -->
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-agent-analysis</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Guava LoadingCache backs SessionManager's concurrent metadata cache. The version is managed by the root POM. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- M1a：FileConfigResolver 读取 HOCON 配置（serenity.conf / pw.conf）。
             版本由根 dependencyManagement 统一管理（与 pw-api-core 同）；显式声明而非依赖
             serenity-core 的传递链（去 Serenity 后仍成立）。 -->
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
        </dependency>

        <!-- Declare external libraries used directly by this module instead of relying on transitive dependencies. -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
        <!-- Gson maps axe.run JSON results to framework-owned models; the root POM manages its version. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- JUnit 4，与 runner 体系统一（原先的 JUnit5 套件收尾设施 SuiteTeardownListener /
             junit-platform-launcher 已随之移除）。
             scope=provided 而非 test：src/main 的 CucumberWithPw 是 JUnit Runner，编译期需要
             org.junit.*；provided 同样在 test classpath 上（本模块单测不受影响），且不向业务传递版本。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>provided</scope>
        </dependency>
        
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito supports unit tests for PageWaits, PageNavigation, BasePage, and related Web classes. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cucumber glue and event listeners use the Java, DataTable, and plugin APIs directly. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-plugin</artifactId>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>datatable</artifactId>
        </dependency>
        <!-- 依赖治理：本项与上面的 junit（均已置 provided）一起，为 src/main 里的
             CucumberWithPw（框架自带的 JUnit4 Runner）提供编译期符号。
             均为 provided：
               - 不向业务传递，避免与业务自己声明的 junit / cucumber-junit 版本打架（enforcer 上界检查）；
               - provided 仍在本模块的 compile 与 test classpath，故本模块可编译并单测该 Runner。
             业务侧使用 @RunWith(CucumberWithPw.class) 时，其自身必然已具备 junit + cucumber-junit。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
